{
  // Cloudflare Workers 정적 자산 설정
  //  - /gangnam 처럼 점포 경로로 들어와도 손님 화면(index.html)이 열리도록
  //    존재하지 않는 경로는 index.html 로 응답합니다.
  //  - 실제 파일(/tljstaffpage.html, /qr.js 등)은 그대로 파일이 우선합니다.
  "name": "trj-agjak",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./",
    "not_found_handling": "single-page-application"
  }
}
